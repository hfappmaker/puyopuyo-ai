{
  "name": "Puyo Puyo AI",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "hostRequirements": {
    "gpu": "optional"
  },
  "runArgs": [
    "--env-file", ".devcontainer/.env",
    "--gpus", "all"
  ],
  "mounts": [
    "source=/mnt/wslg/PulseServer,target=/mnt/wslg/PulseServer,type=bind",
    "source=/mnt/wslg/runtime-dir,target=/mnt/wslg/runtime-dir,type=bind"
  ],
  "containerEnv": {
    "NVIDIA_VISIBLE_DEVICES": "all",
    "NVIDIA_DRIVER_CAPABILITIES": "compute,utility",
    "PULSE_SERVER": "unix:/mnt/wslg/PulseServer",
    "XDG_RUNTIME_DIR": "/mnt/wslg/runtime-dir"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "Anthropic.claude-code",
        "bierner.markdown-mermaid",
        "ms-toolsai.jupyter",
        "ms-python.python",
        "ms-vscode.wasm-dwarf-debugging",
        "vadimcn.vscode-lldb"
      ]
    }
  },
  "forwardPorts": [5173],
  "postCreateCommand": "bash scripts/setup-claude-plugins.sh"
}
